async function getPublishedTestSeries(req, res) {
  try {
    const { examId } = req.params;

    const exam = await Exam.findOne({
      _id: examId,
      isPublished: true,
    });

    if (!exam) {
      return res.status(404).json({
        success: false,
        message: "Exam not found",
      });
    }

    const series = await TestSeries.find({
      exam: examId,
      isPublished: true,
    }).sort({
      sortOrder: 1,
      createdAt: -1,
    });

    const accessibleSeries = [];

    for (const item of series) {
      if (item.accessType !== "PREMIUM") {
        accessibleSeries.push(item);
        continue;
      }

      if (
        req.user?.role !== "student" ||
        !req.user?.userId
      ) {
        continue;
      }

      const accessResult =
        await studentCanAccessTestSeries(
          req.user.userId,
          item._id,
        );

      if (accessResult.allowed) {
        accessibleSeries.push(item);
      }
    }

    return res.status(200).json({
      success: true,
      testSeries: accessibleSeries.map(
        sanitizeTestSeries,
      ),
    });
  } catch (error) {
    console.error(
      "Get published test series error:",
      error,
    );

    return res.status(500).json({
      success: false,
      message: "Unable to load test series",
    });
  }
}
async function getPublishedMockTests(req, res) {
  try {
    const { testSeriesId } = req.params;

    const series = await TestSeries.findOne({
      _id: testSeriesId,
      isPublished: true,
    });

    if (!series) {
      return res.status(404).json({
        success: false,
        message: "Test series not found",
      });
    }

    if (series.accessType === "PREMIUM") {
      if (
        req.user?.role !== "student" ||
        !req.user?.userId
      ) {
        return res.status(403).json({
          success: false,
          message:
            "This test series is available only to students assigned to its batch.",
          reason: "authentication_required",
        });
      }

      const accessResult =
        await studentCanAccessTestSeries(
          req.user.userId,
          series._id,
        );

      if (!accessResult.allowed) {
        return res.status(403).json({
          success: false,
          message:
            "This test series is not assigned to your active batch.",
          reason: accessResult.reason,
        });
      }
    }

    const tests = await MockTest.find({
      testSeries: testSeriesId,
      isPublished: true,
    }).sort({
      sortOrder: 1,
      createdAt: -1,
    });

    return res.status(200).json({
      success: true,
      mockTests: tests.map(sanitizeMockTest),
    });
  } catch (error) {
    console.error(
      "Get published mock tests error:",
      error,
    );

    return res.status(500).json({
      success: false,
      message: "Unable to load mock tests",
    });
  }
}
async function getPublishedMockTest(req, res) {
  try {
    const { slug } = req.params;

    const test = await MockTest.findOne({
      slug: slug.toLowerCase(),
      isPublished: true,
    });

    if (!test) {
      return res.status(404).json({
        success: false,
        message: "Mock test not found",
      });
    }

    if (test.accessType === "PREMIUM") {
      if (
        req.user?.role !== "student" ||
        !req.user?.userId
      ) {
        return res.status(403).json({
          success: false,
          message:
            "This mock test is available only to students assigned to its batch.",
          reason: "authentication_required",
        });
      }

      const accessResult =
        await studentCanAccessTestSeries(
          req.user.userId,
          test.testSeries,
        );

      if (!accessResult.allowed) {
        return res.status(403).json({
          success: false,
          message:
            "This mock test is not assigned to your active batch.",
          reason: accessResult.reason,
        });
      }
    }

    const questions = await Question.find({
      mockTest: test._id,
    }).sort({
      order: 1,
    });

    return res.status(200).json({
      success: true,
      mockTest: sanitizeMockTest(test),
      questions: questions.map(sanitizeQuestion),
    });
  } catch (error) {
    console.error(
      "Get published mock test error:",
      error,
    );

    return res.status(500).json({
      success: false,
      message: "Unable to load mock test",
    });
  }
}
