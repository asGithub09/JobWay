async function getPublishedExams(req, res) {
  try {
    const exams = await Exam.find({
      isPublished: true,
    }).sort({
      sortOrder: 1,
      createdAt: -1,
    });

    return res.status(200).json({
      success: true,
      exams: exams.map(sanitizeExam),
    });
  } catch (error) {
    console.error("Get published exams error:", error);

    return res.status(500).json({
      success: false,
      message: "Unable to load exams",
    });
  }
}

