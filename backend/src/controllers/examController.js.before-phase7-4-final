async function createExam(req, res) {
  try {
    const {
      name,
      slug,
      shortName,
      category,
      description,
      isPublished,
      sortOrder,
    } = req.body;

    if (!name || !name.trim()) {
      return res.status(400).json({
        success: false,
        message: "Exam name is required",
      });
    }

    if (!category || !category.trim()) {
      return res.status(400).json({
        success: false,
        message: "Exam category is required",
      });
    }

    const generatedSlug = createSlug(slug || name);

    if (!generatedSlug) {
      return res.status(400).json({
        success: false,
        message: "A valid exam slug is required",
      });
    }

    const existingExam = await Exam.findOne({
      slug: generatedSlug,
    });

    if (existingExam) {
      return res.status(409).json({
        success: false,
        message: "An exam with this slug already exists",
      });
    }

    const exam = await Exam.create({
      name: name.trim(),
      slug: generatedSlug,
      shortName:
        typeof shortName === "string"
          ? shortName.trim()
          : "",
      category: category.trim(),
      description:
        typeof description === "string"
          ? description.trim()
          : "",
      isPublished: Boolean(isPublished),
      sortOrder: Number.isFinite(Number(sortOrder))
        ? Number(sortOrder)
        : 0,
    });

    return res.status(201).json({
      success: true,
      message: "Exam created successfully",
      exam: sanitizeExam(exam),
    });
  } catch (error) {
    console.error("Create exam error:", error);

    if (error.code === 11000) {
      return res.status(409).json({
        success: false,
        message: "An exam with this slug already exists",
      });
    }

    return res.status(500).json({
      success: false,
      message: "Unable to create exam",
    });
  }
}

/* =========================================================
   FIXED: EXAM UPDATE
   ========================================================= */

async function updateExam(req, res) {
  try {
    const { id } = req.params;

    const exam = await Exam.findById(id);

    if (!exam) {
      return res.status(404).json({
        success: false,
        message: "Exam not found",
      });
    }

    const {
      name,
      slug,
      shortName,
      category,
      description,
      isPublished,
      sortOrder,
    } = req.body;

    if (name !== undefined) {
      if (
        typeof name !== "string" ||
        name.trim().length < 2
      ) {
        return res.status(400).json({
          success: false,
          message:
            "Exam name must contain at least 2 characters",
        });
      }

      exam.name = name.trim();
    }

    if (slug !== undefined) {
      const nextSlug = createSlug(slug);

      if (!nextSlug) {
        return res.status(400).json({
          success: false,
          message: "A valid exam slug is required",
        });
      }

      const duplicate = await Exam.findOne({
        slug: nextSlug,
        _id: {
          $ne: id,
        },
      });

      if (duplicate) {
        return res.status(409).json({
          success: false,
          message: "An exam with this slug already exists",
        });
      }

      exam.slug = nextSlug;
    }

    if (shortName !== undefined) {
      exam.shortName =
        typeof shortName === "string"
          ? shortName.trim()
          : exam.shortName;
    }

    if (category !== undefined) {
      if (
        typeof category !== "string" ||
        !category.trim()
      ) {
        return res.status(400).json({
          success: false,
          message: "Exam category is required",
        });
      }

      exam.category = category.trim();
    }

    if (description !== undefined) {
      exam.description =
        typeof description === "string"
          ? description.trim()
          : exam.description;
    }

    if (isPublished !== undefined) {
      exam.isPublished = Boolean(isPublished);
    }

    if (sortOrder !== undefined) {
      const numericSortOrder = Number(sortOrder);

      if (!Number.isFinite(numericSortOrder)) {
        return res.status(400).json({
          success: false,
          message: "Sort order must be a valid number",
        });
      }

      exam.sortOrder = numericSortOrder;
    }

    await exam.save();

    return res.status(200).json({
      success: true,
      message: "Exam updated successfully",
      exam: sanitizeExam(exam),
    });
  } catch (error) {
    console.error("Update exam error:", error);

    if (error.code === 11000) {
      return res.status(409).json({
        success: false,
        message: "An exam with this slug already exists",
      });
    }

    return res.status(500).json({
      success: false,
      message: "Unable to update exam",
    });
  }
}

async function deleteExam(req, res) {
  try {
    const { id } = req.params;

    const exam = await Exam.findById(id);

    if (!exam) {
      return res.status(404).json({
        success: false,
        message: "Exam not found",
      });
    }

    const seriesCount = await TestSeries.countDocuments({
      exam: id,
    });

    if (seriesCount > 0) {
      return res.status(409).json({
        success: false,
        message:
          "This exam cannot be deleted because it has test series. Delete its test series first.",
      });
    }

    await Exam.findByIdAndDelete(id);

    return res.status(200).json({
      success: true,
      message: "Exam deleted successfully",
    });
  } catch (error) {
    console.error("Delete exam error:", error);

    return res.status(500).json({
      success: false,
      message: "Unable to delete exam",
    });
  }
}

