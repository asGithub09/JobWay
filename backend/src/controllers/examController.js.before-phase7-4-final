async function updateTestSeries(req, res) {
  try {
    const { id } = req.params;

    const series = await TestSeries.findById(id);

    if (!series) {
      return res.status(404).json({
        success: false,
        message: "Test series not found",
      });
    }

    const {
      exam,
      title,
      slug,
      description,
      accessType,
      price,
      discountPrice,
      isPublished,
      sortOrder,
    } = req.body;

    if (exam !== undefined) {
      const parentExam = await Exam.findById(exam);

      if (!parentExam) {
        return res.status(404).json({
          success: false,
          message: "Exam not found",
        });
      }

      series.exam = exam;
    }

    if (title !== undefined) {
      if (
        typeof title !== "string" ||
        title.trim().length < 2
      ) {
        return res.status(400).json({
          success: false,
          message:
            "Test series title must contain at least 2 characters",
        });
      }

      series.title = title.trim();
    }

    if (slug !== undefined) {
      const nextSlug = createSlug(slug);

      if (!nextSlug) {
        return res.status(400).json({
          success: false,
          message:
            "A valid test series slug is required",
        });
      }

      const duplicate = await TestSeries.findOne({
        slug: nextSlug,
        _id: {
          $ne: id,
        },
      });

      if (duplicate) {
        return res.status(409).json({
          success: false,
          message:
            "A test series with this slug already exists",
        });
      }

      series.slug = nextSlug;
    }

    if (description !== undefined) {
      series.description =
        typeof description === "string"
          ? description.trim()
          : series.description;
    }

    if (accessType !== undefined) {
      if (!["FREE", "PREMIUM"].includes(accessType)) {
        return res.status(400).json({
          success: false,
          message:
            "Access type must be FREE or PREMIUM",
        });
      }

      series.accessType = accessType;
    }

    if (price !== undefined) {
      const numericPrice = Number(price);

      if (
        !Number.isFinite(numericPrice) ||
        numericPrice < 0
      ) {
        return res.status(400).json({
          success: false,
          message:
            "Price must be a valid non-negative number",
        });
      }

      series.price = numericPrice;
    }

    if (discountPrice !== undefined) {
      const numericDiscountPrice =
        Number(discountPrice);

      if (
        !Number.isFinite(numericDiscountPrice) ||
        numericDiscountPrice < 0
      ) {
        return res.status(400).json({
          success: false,
          message:
            "Discount price must be a valid non-negative number",
        });
      }

      series.discountPrice = numericDiscountPrice;
    }

    if (isPublished !== undefined) {
      series.isPublished = Boolean(isPublished);
    }

    if (sortOrder !== undefined) {
      const numericSortOrder = Number(sortOrder);

      if (!Number.isFinite(numericSortOrder)) {
        return res.status(400).json({
          success: false,
          message: "Sort order must be a valid number",
        });
      }

      series.sortOrder = numericSortOrder;
    }

    await series.save();

    return res.status(200).json({
      success: true,
      message: "Test series updated successfully",
      testSeries: sanitizeTestSeries(series),
    });
  } catch (error) {
    console.error(
      "Update test series error:",
      error,
    );

    return res.status(500).json({
      success: false,
      message: "Unable to update test series",
    });
  }
}

