async function createQuestion(req, res) {
  try {
    const {
      mockTest,
      questionText,
      options,
      correctAnswer,
      explanation,
      subject,
      topic,
      difficulty,
      order,
    } = req.body;

    if (!mockTest) {
      return res.status(400).json({
        success: false,
        message: "Mock test is required",
      });
    }

    if (!questionText || !questionText.trim()) {
      return res.status(400).json({
        success: false,
        message: "Question text is required",
      });
    }

    if (!Array.isArray(options) || options.length < 2) {
      return res.status(400).json({
        success: false,
        message:
          "At least two question options are required",
      });
    }

    if (
      !correctAnswer ||
      typeof correctAnswer !== "string"
    ) {
      return res.status(400).json({
        success: false,
        message: "Correct answer is required",
      });
    }

    const parentTest = await MockTest.findById(
      mockTest,
    );

    if (!parentTest) {
      return res.status(404).json({
        success: false,
        message: "Mock test not found",
      });
    }

    const normalizedOptions = options
      .filter(
        (option) =>
          option &&
          typeof option.key === "string" &&
          typeof option.text === "string" &&
          option.key.trim() &&
          option.text.trim(),
      )
      .map((option) => ({
        key: option.key.trim(),
        text: option.text.trim(),
      }));

    if (normalizedOptions.length < 2) {
      return res.status(400).json({
        success: false,
        message:
          "At least two valid question options are required",
      });
    }

    const validAnswer = normalizedOptions.some(
      (option) =>
        option.key === correctAnswer.trim(),
    );

    if (!validAnswer) {
      return res.status(400).json({
        success: false,
        message:
          "Correct answer must match one of the option keys",
      });
    }

    const question = await Question.create({
      mockTest,
      questionText: questionText.trim(),
      options: normalizedOptions,
      correctAnswer: correctAnswer.trim(),
      explanation:
        typeof explanation === "string"
          ? explanation.trim()
          : "",
      subject:
        typeof subject === "string"
          ? subject.trim()
          : "",
      topic:
        typeof topic === "string"
          ? topic.trim()
          : "",
      difficulty:
        ["EASY", "MEDIUM", "HARD"].includes(
          difficulty,
        )
          ? difficulty
          : "MEDIUM",
      order:
        Number.isFinite(Number(order))
          ? Number(order)
          : 0,
    });

    const questionCount =
      await Question.countDocuments({
        mockTest,
      });

    parentTest.totalQuestions = questionCount;

    await parentTest.save();

    return res.status(201).json({
      success: true,
      message: "Question created successfully",
      question: sanitizeAdminQuestion(question),
      totalQuestions: questionCount,
    });
  } catch (error) {
    console.error(
      "Create question error:",
      error,
    );

    return res.status(500).json({
      success: false,
      message: "Unable to create question",
    });
  }
}

