          message: "Test series not found",
        });
      }

      test.testSeries = testSeries;
    }

    if (title !== undefined) {
      if (
        typeof title !== "string" ||
        title.trim().length < 2
      ) {
        return res.status(400).json({
          success: false,
          message:
            "Mock test title must contain at least 2 characters",
        });
      }

      test.title = title.trim();
    }

    if (slug !== undefined) {
      const nextSlug = createSlug(slug);

      if (!nextSlug) {
        return res.status(400).json({
          success: false,
          message:
            "A valid mock test slug is required",
        });
      }

      const duplicate = await MockTest.findOne({
        slug: nextSlug,
        _id: {
          $ne: id,
        },
      });

      if (duplicate) {
        return res.status(409).json({
          success: false,
          message:
            "A mock test with this slug already exists",
        });
      }

      test.slug = nextSlug;
    }

    if (description !== undefined) {
      test.description =
        typeof description === "string"
          ? description.trim()
          : test.description;
    }

    if (durationMinutes !== undefined) {
      const value = Number(durationMinutes);

      if (!Number.isFinite(value) || value <= 0) {
        return res.status(400).json({
          success: false,
          message:
            "Duration must be a positive number",
        });
      }

      test.durationMinutes = value;
    }

    if (marksPerQuestion !== undefined) {
      const value = Number(marksPerQuestion);

      if (!Number.isFinite(value) || value < 0) {
        return res.status(400).json({
          success: false,
          message:
            "Marks per question must be a valid non-negative number",
        });
      }

      test.marksPerQuestion = value;
    }

    if (negativeMarking !== undefined) {
      const value = Number(negativeMarking);

      if (!Number.isFinite(value) || value < 0) {
        return res.status(400).json({
          success: false,
          message:
            "Negative marking must be a valid non-negative number",
        });
      }

      test.negativeMarking = value;
    }

    if (accessType !== undefined) {
      if (!["FREE", "PREMIUM"].includes(accessType)) {
        return res.status(400).json({
          success: false,
          message:
            "Access type must be FREE or PREMIUM",
        });
      }

      test.accessType = accessType;
    }

    if (isPublished !== undefined) {
      test.isPublished = Boolean(isPublished);
    }

    if (instructions !== undefined) {
      if (!Array.isArray(instructions)) {
        return res.status(400).json({
          success: false,
          message: "Instructions must be an array",
        });
      }

      test.instructions = instructions.filter(
        (item) =>
          typeof item === "string" &&
          item.trim(),
      );
    }

    if (attemptLimit !== undefined) {
      const value = Number(attemptLimit);

      if (!Number.isFinite(value) || value < 0) {
        return res.status(400).json({
          success: false,
          message:
            "Attempt limit must be a valid non-negative number",
        });
      }

      test.attemptLimit = value;
    }

    if (sortOrder !== undefined) {
      const value = Number(sortOrder);

      if (!Number.isFinite(value)) {
        return res.status(400).json({
          success: false,
          message: "Sort order must be a valid number",
        });
      }

      test.sortOrder = value;
    }

    await test.save();

    return res.status(200).json({
      success: true,
      message: "Mock test updated successfully",
      mockTest: sanitizeMockTest(test),
    });
  } catch (error) {
    console.error(
      "Update mock test error:",
      error,
    );

    if (error.code === 11000) {
      return res.status(409).json({
        success: false,
        message:
          "A mock test with this slug already exists",
      });
    }

    return res.status(500).json({
      success: false,
      message: "Unable to update mock test",
    });
  }
}

async function deleteMockTest(req, res) {
  try {
    const { id } = req.params;

    const test = await MockTest.findById(id);

    if (!test) {
      return res.status(404).json({
        success: false,
        message: "Mock test not found",
      });
    }

    const questionCount = await Question.countDocuments({
      mockTest: id,
    });

    if (questionCount > 0) {
      return res.status(409).json({
        success: false,
        message:
          "This mock test cannot be deleted because it has questions. Delete its questions first.",
      });
    }

    await MockTest.findByIdAndDelete(id);

    return res.status(200).json({
      success: true,
      message: "Mock test deleted successfully",
    });
  } catch (error) {
    console.error(
      "Delete mock test error:",
      error,
    );

    return res.status(500).json({
      success: false,
      message: "Unable to delete mock test",
    });
  }
}

