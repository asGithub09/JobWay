const mongoose = require("mongoose");

const lessonSchema = new mongoose.Schema(
  {
    title: {
      type: String,
      required: true,
      trim: true,
      maxlength: 200,
    },

    description: {
      type: String,
      default: "",
      trim: true,
      maxlength: 2000,
    },

    content: {
      type: String,
      default: "",
    },

    keyPoints: {
      type: [String],
      default: [],
    },

    bullets: {
      type: [String],
      default: [],
    },

    sourceSection: {
      type: String,
      default: "",
      trim: true,
      maxlength: 200,
    },

    order: {
      type: Number,
      default: 0,
      min: 0,
    },
  },
  { _id: true }
);

const learningItemSchema = new mongoose.Schema(
  {
    type: {
      type: String,
      enum: ["LECTURE", "AUDIO", "VIDEO", "RESOURCE", "PRACTICE", "MOCK"],
      required: true,
    },
    title: {
      type: String,
      trim: true,
      maxlength: 200,
      default: "",
    },
    referenceId: {
      type: mongoose.Schema.Types.ObjectId,
      default: null,
    },
    content: {
      type: String,
      default: "",
    },
    url: {
      type: String,
      trim: true,
      default: "",
    },
    order: {
      type: Number,
      default: 0,
      min: 0,
    },
  },
  { _id: true }
);

const moduleSchema = new mongoose.Schema(
  {title: {
      type: String,
      required: true,
      trim: true,
      maxlength: 200,
    },

    description: {
      type: String,
      default: "",
      trim: true,
      maxlength: 2000,
    },

    order: {
      type: Number,
      default: 0,
      min: 0,
    },

    lessons: {
      type: [lessonSchema],
      default: [],
    },

    learningItems: {
      type: [learningItemSchema],
      default: [],
    },
  },
  { _id: true }
);

const practiceQuestionSchema = new mongoose.Schema(
  {
    question: {
      type: String,
      default: "",
      trim: true,
    },

    options: {
      type: [String],
      default: [],
    },

    type: {
      type: String,
      default: "general",
      trim: true,
    },

    sourceSection: {
      type: String,
      default: "",
      trim: true,
    },

    order: {
      type: Number,
      default: 0,
      min: 0,
    },
  },
  { _id: true }
);

const practiceBlockSchema = new mongoose.Schema(
  {
    title: {
      type: String,
      default: "",
      trim: true,
    },

    type: {
      type: String,
      default: "general",
      trim: true,
    },

    description: {
      type: String,
      default: "",
      trim: true,
    },

    questions: {
      type: [practiceQuestionSchema],
      default: [],
    },

    order: {
      type: Number,
      default: 0,
      min: 0,
    },
  },
  { _id: true }
);

const sourceSectionSchema = new mongoose.Schema(
  {
    title: {
      type: String,
      default: "",
      trim: true,
    },

    sourceTitle: {
      type: String,
      default: "",
      trim: true,
    },

    type: {
      type: String,
      default: "heading",
      trim: true,
    },

    confidence: {
      type: Number,
      default: 0,
    },

    isPractice: {
      type: Boolean,
      default: false,
    },

    isProject: {
      type: Boolean,
      default: false,
    },

    practiceType: {
      type: String,
      default: "",
      trim: true,
    },

    text: {
      type: String,
      default: "",
    },

    order: {
      type: Number,
      default: 0,
      min: 0,
    },
  },
  { _id: true }
);

const educatorCourseDraftSchema = new mongoose.Schema(
  {
    title: {
      type: String,
      default: "",
      trim: true,
      maxlength: 150,
    },

    category: {
      type: String,
      default: "",
      trim: true,
      maxlength: 100,
    },

    level: {
      type: String,
      default: "All Levels",
      trim: true,
      maxlength: 50,
    },

    description: {
      type: String,
      default: "",
      trim: true,
      maxlength: 3000,
    },

    duration: {
      type: String,
      default: "Self Paced",
      trim: true,
      maxlength: 100,
    },

    language: {
      type: String,
      default: "English / Hindi",
      trim: true,
      maxlength: 100,
    },

    features: {
      type: [String],
      default: [],
    },

    modules: {
      type: [moduleSchema],
      default: [],
    },

    practice: {
      type: [practiceBlockSchema],
      default: [],
    },

    sourceSections: {
      type: [sourceSectionSchema],
      default: [],
    },

    summary: {
      type: mongoose.Schema.Types.Mixed,
      default: {},
    },

    sourceFileName: {
      type: String,
      required: true,
      trim: true,
    },

    sourceExtension: {
      type: String,
      required: true,
      trim: true,
      lowercase: true,
    },

    sourceMimeType: {
      type: String,
      default: "",
      trim: true,
    },

    sourceCharacterCount: {
      type: Number,
      default: 0,
      min: 0,
    },

    sourceWordCount: {
      type: Number,
      default: 0,
      min: 0,
    },

    sourcePageCount: {
      type: Number,
      default: 0,
      min: 0,
    },

    sourceMetadata: {
      type: mongoose.Schema.Types.Mixed,
      default: {},
    },

    generationMode: {
      type: String,
      enum: ["RULE_BASED", "AI"],
      default: "RULE_BASED",
    },

    detectionMode: {
      type: String,
      default: "",
      trim: true,
    },

    status: {
      type: String,
      enum: [
        "PROCESSING",
        "READY_FOR_REVIEW",
        "FAILED",
      ],
      default: "PROCESSING",
      index: true,
    },

    errorMessage: {
      type: String,
      default: "",
      trim: true,
      maxlength: 2000,
    },

    createdBy: {
      type: mongoose.Schema.Types.ObjectId,
      ref: "User",
      required: true,
      index: true,
    },
  },
  {
    timestamps: true,
  }
);

educatorCourseDraftSchema.index({
  createdBy: 1,
  createdAt: -1,
});

module.exports =
  mongoose.models.EducatorCourseDraft ||
  mongoose.model(
    "EducatorCourseDraft",
    educatorCourseDraftSchema
  );
