const CourseV2 = require("../models/CourseV2");

function normalizeOrders(modules = []) {
  return modules.map((module, moduleIndex) => ({
    ...module,
    order: moduleIndex + 1,
    items: (module.items || []).map((item, itemIndex) => ({
      ...item,
      order: itemIndex + 1,
    })),
  }));
}

function slugify(value = "") {
  return value
    .toString()
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 100);
}

async function createCourseV2({ createdBy, data = {} }) {
  const title = String(data.title || "").trim();

  if (!title) {
    const error = new Error("Course title is required.");
    error.statusCode = 400;
    throw error;
  }

  let baseSlug = slugify(data.slug || title);

  if (!baseSlug) {
    baseSlug = `course-${Date.now()}`;
  }

  let slug = baseSlug;
  let counter = 2;

  while (await CourseV2.exists({ slug })) {
    slug = `${baseSlug}-${counter}`;
    counter += 1;
  }

  const course = await CourseV2.create({
    ...data,
    title,
    slug,
    createdBy,
    modules: normalizeOrders(data.modules || []),
    status: "DRAFT",
  });

  return course;
}

async function getCourseV2(courseId, userId) {
  return CourseV2.findOne({
    _id: courseId,
    createdBy: userId,
  });
}

async function updateCourseV2(courseId, userId, data = {}) {
  const course = await getCourseV2(courseId, userId);

  if (!course) {
    const error = new Error("Course not found.");
    error.statusCode = 404;
    throw error;
  }

  if (course.status === "PUBLISHED") {
    const error = new Error("Published courses cannot be edited.");
    error.statusCode = 409;
    throw error;
  }

  const allowedFields = [
    "title",
    "description",
    "category",
    "level",
    "language",
    "thumbnail",
    "modules",
    "source",
  ];

  for (const field of allowedFields) {
    if (data[field] !== undefined) {
      course.set(
        field,
        field === "modules"
          ? normalizeOrders(data[field] || [])
          : data[field]
      );
    }
  }

  await course.save();

  return course;
}

async function deleteCourseV2(courseId, userId) {
  const course = await getCourseV2(courseId, userId);

  if (!course) {
    const error = new Error("Course not found.");
    error.statusCode = 404;
    throw error;
  }

  if (course.status === "PUBLISHED") {
    const error = new Error("Published courses cannot be deleted.");
    error.statusCode = 409;
    throw error;
  }

  await CourseV2.deleteOne({ _id: course._id });

  return true;
}

module.exports = {
  createCourseV2,
  getCourseV2,
  updateCourseV2,
  deleteCourseV2,
  normalizeOrders,
  slugify,
};
