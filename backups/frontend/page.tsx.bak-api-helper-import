"use client";


import {
  ChangeEvent,
  useCallback,
  useEffect,
  useState,
} from "react";
import { useParams, useRouter } from "next/navigation";
import {
  ArrowLeft,
  BookOpen,
  CheckCircle2,
  ChevronDown,
  ChevronUp,
  FileText,
  GraduationCap,
  Loader2,
  Plus,
  Save,
  Send,
  Trash2,
} from "lucide-react";

import { useAuth } from "@/context/AuthContext";

type EducatorMock = {
  id: string;
  title: string;
  slug: string;
  durationMinutes?: number;
  totalQuestions?: number;
  isPublished?: boolean;
};

type QuestionBankQuestion = {
  id: string;
  questionCode?: string;
  questionText: string;
  questionType?: string;
  options?: unknown[];
  subject?: string;
  topic?: string;
  difficulty?: string;
  status?: string;
};

type Lesson = {
  title: string;
  description?: string;
  content?: string;
  keyPoints?: string[];
  bullets?: string[];
  sourceSection?: string;
  order?: number;
};

type LearningItem = {
  type: "AUDIO" | "VIDEO" | "IMAGE" | "RESOURCE" | "PRACTICE" | "MOCK";
  title?: string;
  referenceId?: string | null;
  referenceIds?: string[];
  content?: string;
  url?: string;
  order?: number;
};

type Module = {
  title: string;
  description?: string;
  lessons?: Lesson[];
  learningItems?: LearningItem[];
  order?: number;
};

type PracticeQuestion = {
  question?: string;
  options?: string[];
  type?: string;
  sourceSection?: string;
  order?: number;
};

type PracticeBlock = {
  title?: string;
  type?: string;
  description?: string;
  questions?: PracticeQuestion[];
  order?: number;
};

type Draft = {
  id: string;
  title: string;
  category: string;
  level: string;
  description: string;
  duration: string;
  language: string;
  features: string[];
  modules: Module[];
  practice: PracticeBlock[];
  sourceSections: unknown[];
  sourceFileName?: string;
  sourceExtension?: string;
  sourceMimeType?: string;
  sourceCharacterCount?: number;
  sourceWordCount?: number;
  sourcePageCount?: number;
  generationMode?: string;
  detectionMode?: string;
  status: string;
};

function getErrorMessage(error: unknown) {
  if (error instanceof Error) {
    return error.message;
  }

  return "Something went wrong.";
}

export default function ReviewEducatorCoursePage() {
  const router = useRouter();
  const params = useParams();
  const { token } = useAuth();

  const draftId =
    typeof params?.id === "string"
      ? params.id
      : "";

  const [draft, setDraft] =
    useState<Draft | null>(null);

  const [loading, setLoading] =
    useState(true);

  const [saving, setSaving] =
    useState(false);

  const [publishing, setPublishing] =
    useState(false);

  const [error, setError] =
    useState("");

  const [success, setSuccess] =
    useState("");

  const [openModules, setOpenModules] =
    useState<Record<number, boolean>>({});

  const [availableMocks, setAvailableMocks] = useState<EducatorMock[]>([]);
  const [mockLoading, setMockLoading] = useState(false);
  const [uploadingLearningMedia, setUploadingLearningMedia] =
    useState<string | null>(null);

  const [learningMediaUploadError, setLearningMediaUploadError] =
    useState("");
  const [mockError, setMockError] = useState("");

  const [questionBank, setQuestionBank] =
    useState<QuestionBankQuestion[]>([]);

  const [questionBankLoading, setQuestionBankLoading] =
    useState(false);

  const [questionBankError, setQuestionBankError] =
    useState("");

  const [questionBankSearch, setQuestionBankSearch] =
    useState("");

  const [questionPicker, setQuestionPicker] =
    useState<{
      moduleIndex: number;
      itemIndex: number;
    } | null>(null);

  const loadAvailableMocks = useCallback(async () => {
    if (!token) {
      return;
    }

    setMockLoading(true);
    setMockError("");

    try {
      const response = await fetch(
        "/api/educator/mocks/available",
        {
          cache: "no-store",
          headers: {
            Authorization: `Bearer ${token}`,
          },
        },
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data?.message ||
            "Unable to load available Mock Tests.",
        );
      }

      setAvailableMocks(data.mocks || []);
    } catch (err) {
      setMockError(getErrorMessage(err));
    } finally {
      setMockLoading(false);
    }
  }, [token]);
  const loadQuestionBank = useCallback(async () => {
    if (!token) {
      return;
    }

    setQuestionBankLoading(true);
    setQuestionBankError("");

    try {
      const response = await fetch(
        "/api/educator/questions?page=1&pageSize=100",
        {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data?.message ||
            "Unable to load Question Bank."
        );
      }

      setQuestionBank(data.questions || []);
    } catch (err) {
      setQuestionBankError(
        getErrorMessage(err)
      );
    } finally {
      setQuestionBankLoading(false);
    }
  }, [token]);

  const loadDraft = useCallback(async () => {
    if (!token || !draftId) {
      return;
    }

    setLoading(true);
    setError("");

    try {
      const response = await fetch(
        `/api/educator/course-import/drafts/${draftId}`,
        {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data?.message ||
            "Unable to load course draft."
        );
      }

      setDraft(data.draft);

      const initialOpenState: Record<
        number,
        boolean
      > = {};

      (data.draft.modules || []).forEach(
        (_module: Module, index: number) => {
          initialOpenState[index] =
            index === 0;
        }
      );

      setOpenModules(initialOpenState);
    } catch (err) {
      setError(getErrorMessage(err));
    } finally {
      setLoading(false);
    }
  }, [token, draftId]);

  useEffect(() => {
    if (!token) {
      return;
    }

    loadDraft();
    loadQuestionBank();
    loadAvailableMocks();
  }, [
    token,
    loadDraft,
    loadQuestionBank,
    loadAvailableMocks,
  ]);

  const updateDraftField = <
    K extends keyof Draft
  >(
    field: K,
    value: Draft[K]
  ) => {
    setDraft((current) =>
      current
        ? {
            ...current,
            [field]: value,
          }
        : current
    );
  };

  const updateModule = (
    moduleIndex: number,
    field: keyof Module,
    value: string
  ) => {
    setDraft((current) => {
      if (!current) {
        return current;
      }

      const modules = [...current.modules];

      modules[moduleIndex] = {
        ...modules[moduleIndex],
        [field]: value,
      };

      return {
        ...current,
        modules,
      };
    });
  };

  const updateLesson = (
    moduleIndex: number,
    lessonIndex: number,
    field: keyof Lesson,
    value: string
  ) => {
    setDraft((current) => {
      if (!current) {
        return current;
      }

      const modules = [...current.modules];

      const lessons = [
        ...(modules[moduleIndex]
          .lessons || []),
      ];

      lessons[lessonIndex] = {
        ...lessons[lessonIndex],
        [field]: value,
      };

      modules[moduleIndex] = {
        ...modules[moduleIndex],
        lessons,
      };

      return {
        ...current,
        modules,
      };
    });
  };

  const addModule = () => {
    setDraft((current) => {
      if (!current) {
        return current;
      }

      const modules = [
        ...current.modules,
        {
          title: `New Module ${
            current.modules.length + 1
          }`,
          description: "",
          lessons: [],
          learningItems: [],
          order: current.modules.length + 1,
        },
      ];

      return {
        ...current,
        modules,
      };
    });
  };

  const removeModule = (
    moduleIndex: number
  ) => {
    setDraft((current) => {
      if (!current) {
        return current;
      }

      const modules =
        current.modules.filter(
          (_module, index) =>
            index !== moduleIndex
        );

      return {
        ...current,
        modules,
      };
    });
  };

  const addLesson = (
    moduleIndex: number
  ) => {
    setDraft((current) => {
      if (!current) {
        return current;
      }

      const modules = [...current.modules];

      const lessons = [
        ...(modules[moduleIndex]
          .lessons || []),
        {
          title: "New Lesson",
          description: "",
          content: "",
          keyPoints: [],
          bullets: [],
          sourceSection: "",
          order:
            (modules[moduleIndex]
              .lessons?.length || 0) + 1,
        },
      ];

      modules[moduleIndex] = {
        ...modules[moduleIndex],
        lessons,
      };

      return {
        ...current,
        modules,
      };
    });
  };

  const removeLesson = (
    moduleIndex: number,
    lessonIndex: number
  ) => {
    setDraft((current) => {
      if (!current) {
        return current;
      }

      const modules = [...current.modules];

      const lessons = (
        modules[moduleIndex].lessons || []
      ).filter(
        (_lesson, index) =>
          index !== lessonIndex
      );

      modules[moduleIndex] = {
        ...modules[moduleIndex],
        lessons,
      };

      return {
        ...current,
        modules,
      };
    });
  };

  const addLearningItem = (
    moduleIndex: number,
    type: LearningItem["type"]
  ) => {
    setDraft((current) => {
      if (!current) {
        return current;
      }

      const modules = [...current.modules];
      const module = modules[moduleIndex];

      const learningItems = [
        ...(module.learningItems || []),
        {
          type,
          title:
              type === "IMAGE"
                ? "New Image"
                : type === "AUDIO"
                  ? "New Audio"
                  : type === "VIDEO"
                    ? "New Video"
                    : type === "RESOURCE"
                      ? "New Resource"
                      : type === "PRACTICE"
                        ? "Practice"
                        : "MCQ Checkpoint",
          referenceId: null,
          referenceIds: [],
          content: "",
          url: "",
          order:
            (module.learningItems?.length || 0) + 1,
        },
      ];

      modules[moduleIndex] = {
        ...module,
        learningItems,
      };

      return {
        ...current,
        modules,
      };
    });
  };

  const selectQuestionForLearningItem = (
    questionId: string
  ) => {
    if (!questionPicker) {
      return;
    }

    const { moduleIndex, itemIndex } = questionPicker;

    setDraft((current) => {
      if (!current) return current;

      const modules = [...current.modules];
      const module = modules[moduleIndex];

      if (!module) {
        return current;
      }

      const learningItems = [
        ...(module.learningItems || []),
      ];

      const item = learningItems[itemIndex];

      if (!item) {
        return current;
      }

      const referenceIds = Array.from(
        new Set([
          ...(item.referenceIds || []),
          questionId,
        ])
      );

      learningItems[itemIndex] = {
        ...item,
        referenceIds,
      };

      modules[moduleIndex] = {
        ...module,
        learningItems,
      };

      return {
        ...current,
        modules,
      };
    });
  };

  const removeQuestionFromLearningItem = (
    moduleIndex: number,
    itemIndex: number,
    questionId: string
  ) => {
    setDraft((current) => {
      if (!current) return current;

      const modules = [...current.modules];
      const module = modules[moduleIndex];

      if (!module) {
        return current;
      }

      const learningItems = [
        ...(module.learningItems || []),
      ];

      const item = learningItems[itemIndex];

      if (!item) {
        return current;
      }

      learningItems[itemIndex] = {
        ...item,
        referenceIds: (item.referenceIds || []).filter(
          (id) => id !== questionId
        ),
      };

      modules[moduleIndex] = {
        ...module,
        learningItems,
      };

      return {
        ...current,
        modules,
      };
    });
  };

  const getQuestionBankMatches = () => {
    const search = questionBankSearch
      .trim()
      .toLowerCase();

    if (!search) {
      return questionBank;
    }

    return questionBank.filter((question) =>
      [
        question.questionText,
        question.questionCode,
        question.subject,
        question.topic,
        question.difficulty,
      ]
        .filter(Boolean)
        .some((value) =>
          String(value)
            .toLowerCase()
            .includes(search)
        )
    );
  };

  const uploadLearningMedia = async (
    moduleIndex: number,
    itemIndex: number,
    type: "IMAGE" | "VIDEO",
    file: File
  ) => {
    if (!token) {
      setLearningMediaUploadError(
        "Authentication is required to upload media."
      );
      return;
    }

    const uploadKey = `${moduleIndex}-${itemIndex}`;

    setUploadingLearningMedia(uploadKey);
    setLearningMediaUploadError("");

    try {
      const formData = new FormData();

      formData.append("file", file);
      formData.append("type", type);

      const response = await fetch(
        "/api/educator/course-import/media",
        {
          method: "POST",
          headers: {
            Authorization: `Bearer ${token}`,
          },
          body: formData,
        }
      );

      const data = await response.json().catch(
        () => null
      );

      if (!response.ok || !data?.success || !data?.url) {
        throw new Error(
          data?.message ||
            `Unable to upload ${type.toLowerCase()}.`
        );
      }

      updateLearningItem(
        moduleIndex,
        itemIndex,
        "url",
        data.url
      );
    } catch (error) {
      console.error(
        "Learning media upload error:",
        error
      );

      setLearningMediaUploadError(
        error instanceof Error
          ? error.message
          : "Unable to upload media."
      );
    } finally {
      setUploadingLearningMedia(null);
    }
  };
  const updateLearningItem = (
    moduleIndex: number,
    itemIndex: number,
    field: keyof LearningItem,
    value: string
  ) => {
    setDraft((current) => {
      if (!current) {
        return current;
      }

      const modules = [...current.modules];
      const module = modules[moduleIndex];

      const learningItems = [
        ...(module.learningItems || []),
      ];

      learningItems[itemIndex] = {
        ...learningItems[itemIndex],
        [field]: value,
      };

      modules[moduleIndex] = {
        ...module,
        learningItems,
      };

      return {
        ...current,
        modules,
      };
    });
  };

  const removeLearningItem = (
    moduleIndex: number,
    itemIndex: number
  ) => {
    setDraft((current) => {
      if (!current) {
        return current;
      }

      const modules = [...current.modules];
      const module = modules[moduleIndex];

      const learningItems = (
        module.learningItems || []
      )
        .filter(
          (_item, index) => index !== itemIndex
        )
        .map((item, index) => ({
          ...item,
          order: index + 1,
        }));

      modules[moduleIndex] = {
        ...module,
        learningItems,
      };

      return {
        ...current,
        modules,
      };
    });
  };

  const saveDraft = async () => {
    if (!draft || !token) {
      return;
    }

    setSaving(true);
    setError("");
    setSuccess("");

    try {
      const response = await fetch(
        `/api/educator/course-import/drafts/${draft.id}`,
        {
          method: "PATCH",

          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
          },

          body: JSON.stringify({
            title: draft.title,
            category: draft.category,
            level: draft.level,
            description: draft.description,
            duration: draft.duration,
            language: draft.language,
            features: draft.features,
            modules: draft.modules,
            practice: draft.practice,
            sourceSections:
              draft.sourceSections,
          }),
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data?.message ||
            "Unable to save changes."
        );
      }

      setDraft(data.draft);

      setSuccess(
        "Course changes saved successfully."
      );
    } catch (err) {
      setError(getErrorMessage(err));
    } finally {
      setSaving(false);
    }
  };

  const saveAsCourse = async () => {
    if (!draft || !token) {
      return;
    }

    setSaving(true);
    setError("");
    setSuccess("");

    try {
      const updateResponse = await fetch(
        `/api/educator/course-import/drafts/${draft.id}`,
        {
          method: "PATCH",

          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
          },

          body: JSON.stringify({
            title: draft.title,
            category: draft.category,
            level: draft.level,
            description: draft.description,
            duration: draft.duration,
            language: draft.language,
            features: draft.features,
            modules: draft.modules,
            practice: draft.practice,
            sourceSections:
              draft.sourceSections,
          }),
        }
      );

      const updateData =
        await updateResponse.json();

      if (!updateResponse.ok) {
        throw new Error(
          updateData?.message ||
            "Unable to save changes."
        );
      }

      const saveResponse = await fetch(
        `/api/educator/course-import/drafts/${draft.id}/save`,
        {
          method: "POST",

          headers: {
            Authorization: `Bearer ${token}`,
          },
        }
      );

      const saveData =
        await saveResponse.json();

      if (!saveResponse.ok) {
        throw new Error(
          saveData?.message ||
            "Unable to save course."
        );
      }

      setSuccess(
        "Course saved as a draft successfully."
      );

      setTimeout(() => {
        router.push("/educator/courses");
      }, 700);
    } catch (err) {
      setError(getErrorMessage(err));
    } finally {
      setSaving(false);
    }
  };

  const publishCourse = async () => {
    if (!draft || !token) {
      return;
    }

    setPublishing(true);
    setError("");
    setSuccess("");

    try {
      const updateResponse = await fetch(
        `/api/educator/course-import/drafts/${draft.id}`,
        {
          method: "PATCH",

          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
          },

          body: JSON.stringify({
            title: draft.title,
            category: draft.category,
            level: draft.level,
            description: draft.description,
            duration: draft.duration,
            language: draft.language,
            features: draft.features,
            modules: draft.modules,
            practice: draft.practice,
            sourceSections:
              draft.sourceSections,
          }),
        }
      );

      const updateData =
        await updateResponse.json();

      if (!updateResponse.ok) {
        throw new Error(
          updateData?.message ||
            "Unable to save changes."
        );
      }

      const saveResponse = await fetch(
        `/api/educator/course-import/drafts/${draft.id}/save`,
        {
          method: "POST",

          headers: {
            Authorization: `Bearer ${token}`,
          },
        }
      );

      const saveData =
        await saveResponse.json();

      if (!saveResponse.ok) {
        throw new Error(
          saveData?.message ||
            "Unable to save course."
        );
      }

      const courseId =
        saveData?.course?.id;

      if (!courseId) {
        throw new Error(
          "Course was saved but no course ID was returned."
        );
      }

      const publishResponse =
        await fetch(
          `/api/educator/courses/${courseId}/publish`,
          {
            method: "POST",

            headers: {
              Authorization: `Bearer ${token}`,
            },
          }
        );

      const publishData =
        await publishResponse.json();

      if (!publishResponse.ok) {
        throw new Error(
          publishData?.message ||
            "Unable to publish course."
        );
      }

      setSuccess(
        "Course published successfully."
      );

      setTimeout(() => {
        router.push("/educator/courses");
      }, 700);
    } catch (err) {
      setError(getErrorMessage(err));
    } finally {
      setPublishing(false);
    }
  };

  const toggleModule = (
    index: number
  ) => {
    setOpenModules((current) => ({
      ...current,
      [index]: !current[index],
    }));
  };

  if (!token) {
    return null;
  }

  if (loading) {
    return (
      <main className="flex min-h-screen items-center justify-center bg-slate-50">
        <div className="flex items-center gap-3 text-slate-600">
          <Loader2
            className="h-5 w-5 animate-spin"
            aria-hidden="true"
          />
          Loading course review...
        </div>
      </main>
    );
  }

  if (!draft) {
    return (
      <main className="min-h-screen bg-slate-50">
        <div className="mx-auto max-w-4xl px-6 py-12">
          <div className="rounded-3xl border border-red-200 bg-white p-8 shadow-sm">
            <h1 className="text-xl font-bold text-slate-900">
              Course draft not found
            </h1>

            <p className="mt-2 text-sm text-slate-600">
              {error ||
                "The requested course draft could not be loaded."}
            </p>

            <button
              type="button"
              onClick={() =>
                router.push(
                  "/educator/courses"
                )
              }
              className="mt-6 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white"
            >
              Back to Courses
            </button>
          </div>
        </div>
      </main>
    );
  }

  return (
    <main className="min-h-screen bg-slate-50">
      <div className="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        {/* Top navigation */}
        <div className="mb-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <button
            type="button"
            onClick={() =>
              router.push(
                "/educator/courses"
              )
            }
            className="inline-flex w-fit items-center gap-2 text-sm font-medium text-slate-600 hover:text-slate-900"
          >
            <ArrowLeft
              className="h-4 w-4"
              aria-hidden="true"
            />
            Back to Courses
          </button>

          <div className="flex flex-wrap gap-2">
            <button
              type="button"
              onClick={saveDraft}
              disabled={
                saving || publishing
              }
              className="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50"
            >
              {saving ? (
                <Loader2
                  className="h-4 w-4 animate-spin"
                  aria-hidden="true"
                />
              ) : (
                <Save
                  className="h-4 w-4"
                  aria-hidden="true"
                />
              )}
              Save Changes
            </button>

            <button
              type="button"
              onClick={saveAsCourse}
              disabled={
                saving || publishing
              }
              className="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-800 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-700 disabled:cursor-not-allowed disabled:opacity-50"
            >
              <Save
                className="h-4 w-4"
                aria-hidden="true"
              />
              Save Draft
            </button>

            <button
              type="button"
              onClick={publishCourse}
              disabled={
                saving || publishing
              }
              className="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-50"
            >
              {publishing ? (
                <Loader2
                  className="h-4 w-4 animate-spin"
                  aria-hidden="true"
                />
              ) : (
                <Send
                  className="h-4 w-4"
                  aria-hidden="true"
                />
              )}
              Publish Course
            </button>
